{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "10.75.0",
    "bcryptjs": "3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "18.0.1",
    "file-type": "16.5.4",
    "multer": "^2.4.0",
    "nestjs-pino": "5.2.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
