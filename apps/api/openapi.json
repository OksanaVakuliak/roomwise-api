                      "wastePercent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "productCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "surface",
                      "wastePercent",
                      "productCount"
                    ],
                    "additionalProperties": false
