{
  "name": "roomwise-api",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --filter api run typecheck",
    "test": "vitest run",
    "build": "pnpm --filter api run build",
    "commit": "cz",
    "prepare": "lefthook install || exit 0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.6.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
